---
processes:
  - name: envoy-tcp-router-control-plane
    executable: /var/vcap/packages/envoy-tcp-router/bin/envoy-tcp-router
    args:
      - -xds-port=<%= p("envoy_tcp_router.xds_port") %>
      - -node-id=<%= p("envoy_tcp_router.node_id") %>
      - -routing-api-url=<%= "#{p("routing_api.uri")}:#{p("routing_api.port")}" %>
      - -filter-path=/var/vcap/packages/envoy-tcp-router/bin/filter.so
      - -refresh-interval=<%= p("envoy_tcp_router.refresh_interval") %>
    env:
      ROUTING_API_CLIENT_CERT_FILE: /var/vcap/jobs/envoy-tcp-router/config/certs/routing-api/client.crt
      ROUTING_API_CLIENT_KEY_FILE: /var/vcap/jobs/envoy-tcp-router/config/keys/routing-api/client.key
      ROUTING_API_CA_CERT_FILE: /var/vcap/jobs/envoy-tcp-router/config/certs/routing-api/ca_cert.crt
    additional_volumes:
      - path: /var/vcap/sys/log/envoy-tcp-router
        writable: true
      - path: /var/vcap/sys/run/envoy-tcp-router
        writable: true

  - name: envoy
    executable: /var/vcap/packages/envoy/bin/envoy
    args:
      - -c
      - /var/vcap/jobs/envoy-tcp-router/config/envoy_config.yaml
      - --log-level
      - info
    capabilities:
      - NET_BIND_SERVICE
    additional_volumes:
      - path: /var/vcap/sys/log/envoy-tcp-router
        writable: true
      - path: /var/vcap/sys/run/envoy-tcp-router
        writable: true
