---
processes:
  - name: envoy-tcp-router-control-plane
    executable: /var/vcap/packages/envoy-tcp-router/bin/envoy-tcp-router
    args:
      - -xds-port=<%= p("envoy_tcp_router.xds_port") %>
      - -node-id=<%= p("envoy_tcp_router.node_id") %>
      - -routing-api-url=<%= "#{p("routing_api.uri")}:#{p("routing_api.port")}" %>
      - -refresh-interval=<%= p("envoy_tcp_router.refresh_interval") %>
      - -routing-api-ca-cert=/var/vcap/jobs/envoy-tcp-router/config/certs/routing-api/ca_cert.crt
      - -routing-api-client-cert=/var/vcap/jobs/envoy-tcp-router/config/certs/routing-api/client.crt
      - -routing-api-client-key=/var/vcap/jobs/envoy-tcp-router/config/keys/routing-api/client.key
      - -uaa-client-secret=<%= p("uaa.client_secret") %>
      - -uaa-url=<%= p("uaa.token_endpoint") %>
      - -uaa-port=<%= p("uaa.tls_port") %>
      - -uaa-ca-cert=/var/vcap/jobs/envoy-tcp-router/config/certs/uaa/ca.crt
      - -routing-api-auth-disabled=<%= p("routing_api.auth_disabled") %>
    additional_volumes:
      - path: /var/vcap/sys/log/envoy-tcp-router
        writable: true
      - path: /var/vcap/sys/run/envoy-tcp-router
        writable: true

  - name: envoy
    executable: /var/vcap/packages/envoy/bin/envoy
    env:
      GODEBUG: cgocheck=0
    args:
      - -c
      - /var/vcap/jobs/envoy-tcp-router/config/envoy_config.yaml
      - --log-level
      - info
    capabilities:
      - NET_BIND_SERVICE
    additional_volumes:
      - path: /var/vcap/sys/log/envoy-tcp-router
        writable: true
      - path: /var/vcap/sys/run/envoy-tcp-router
        writable: true
