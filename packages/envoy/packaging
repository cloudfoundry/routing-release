set -ex

mkdir -p "${BOSH_INSTALL_TARGET}/bin"

BLOB=$(ls envoy/envoy-*.tar.gz)

if tar tzf "$BLOB" > /dev/null 2>&1; then
  tar xzf "$BLOB"
  ENVOY_BIN=$(find . -maxdepth 3 \( -name 'envoy' -o -name 'envoy-static' \) -type f | head -1)
  cp "$ENVOY_BIN" "${BOSH_INSTALL_TARGET}/bin/envoy"
elif gzip -t "$BLOB" > /dev/null 2>&1; then
  gunzip -c "$BLOB" > "${BOSH_INSTALL_TARGET}/bin/envoy"
else
  # Plain uncompressed binary — copy directly (official Envoy GitHub releases)
  cp "$BLOB" "${BOSH_INSTALL_TARGET}/bin/envoy"
fi

chmod 755 "${BOSH_INSTALL_TARGET}/bin/envoy"
